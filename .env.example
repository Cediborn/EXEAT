# ---------------------------------------------------------------------------
# Entryout backend configuration (copy to .env and adjust; NEVER commit .env)
# ---------------------------------------------------------------------------

# HTTP
PORT=8787
# "development" | "test" | "production"
NODE_ENV=development

# Temporary development dashboard bypass (see README "Development bypass").
# When enabled, POST /api/auth/dev-session opens the dashboards with a demo
# test session. Ignored entirely when NODE_ENV=production (always off there);
# set to "false" to restore normal sign-in behaviour in development too.
DEV_BYPASS_AUTH=true

# Absolute base URL of this API, used for links inside issued passes.
# e.g. https://entryout-api.onrender.com
API_PUBLIC_URL=http://localhost:8787

# CORS: comma separated origins allowed to call the API with credentials.
# Required when the frontend is hosted separately (e.g. GitHub Pages).
# e.g. https://cediborn.github.io
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Storage
DATABASE_PATH=data/entryout.sqlite

# Sessions
SESSION_TTL_HOURS=12
# Set to "true" when the API is served over HTTPS in production.
COOKIE_SECURE=false

# Student self-registration code (students need the school-issued code to sign up).
# Leave blank to disable self-registration entirely (accounts are then created by an admin).
STUDENT_ENROLLMENT_CODE=MFANTSIPIM-2026

# Default school policies (configurable later from the admin settings screen).
EXTERNAL_MIN_NOTICE_HOURS=24
MAX_DURATION_HOURS=72
RETURN_GRACE_MINUTES=60
EARLY_DEPARTURE_MINUTES=30

# Emergency contact shown to students on urgent medical requests.
EMERGENCY_CONTACT_PHONE=+233 33 213 0331

# Outbound notifications ---------------------------------------------------
# In-app notifications always work. Email/SMS are only attempted when a
# webhook URL is configured; no message is ever reported as "sent" unless the
# provider accepted it. Point this at an automation endpoint that forwards to a
# provider such as Africa's Talking, Twilio, or Resend.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
NOTIFY_TIMEOUT_MS=5000
